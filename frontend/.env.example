# Flowdesk Frontend Environment Variables

# Backend API base URL
# - Local dev: leave unset or use http://localhost:5000/api (Vite proxies /api to backend)
# - Production (same-domain or proxy): /api
# - Production (separate domain): https://your-backend-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Real-Time Socket.IO server base URL (optional)
# - When omitted, automatically derived from VITE_API_URL origin or window.location.origin
# - Explicit override example: https://your-backend-api.onrender.com
# VITE_SOCKET_URL=http://localhost:5000
